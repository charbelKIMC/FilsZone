# Copier ce fichier en .env puis l'adapter. Le .env n'est jamais versionné (il contient les mots de passe).

# true : affiche le détail des erreurs et active /db-test. Toujours false en production.
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wifi_zone
DB_USER=root
DB_PASS=

# Adresse exacte du front s'il est hébergé sur un autre domaine ; * sinon
CORS_ORIGIN=*
# Minutes sans activité avant fermeture automatique d'une session Wi-Fi
SESSION_INACTIVITE_MINUTES=15
# Lax si le front est sur le même domaine ; None si le front est hébergé ailleurs (HTTPS obligatoire)
SESSION_SAMESITE=Lax
